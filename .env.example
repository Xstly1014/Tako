# Copy to .env locally. Never commit real credentials.
MYSQL_DATABASE=writing
MYSQL_USER=writing
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
APP_ORIGIN=http://localhost:3000
AUTH_PEPPER=
# Independent 32-byte random key encoded as 64 hex characters. Preserve with backups.
MAIL_ENCRYPTION_KEY=
# false is allowed only for local HTTP development. Production requires HTTPS.
COOKIE_SECURE=false
# starttls (usually 587) or implicit (usually 465); insecure SMTP is not supported.
SMTP_TLS_MODE=starttls
# Local-only API documentation. Keep false for a public deployment by default.
API_ENABLE_DOCS=true

# smtp (default) or resend. Only the selected provider is used.
MAIL_PROVIDER=smtp
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Independent AES-256 backup key, 64 hex characters. Store separately from backups.
BACKUP_ENCRYPTION_KEY=

# Explicitly authorized operational alert recipient, summaries only.
ALERT_TO=
DATABASE_WARNING_BYTES=536870912

OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SESSION_TOKEN=

# B1 private testing only; migrate before enabling. Not a complete B release.
PUBLICATION_ENABLED=false
# Comma-separated existing account UUIDs; empty means no operator access.
OPERATOR_ACCOUNT_IDS=

# email preserves existing login until account password setup; password disables OTP endpoints.
AUTH_MODE=email

# Keep environment identities and cookies separate; production/test use dedicated values.
APP_ENVIRONMENT=local
SESSION_COOKIE_NAME=tako_session
