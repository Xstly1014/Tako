# Copy to .env locally. Never commit real credentials.
MYSQL_DATABASE=writing
MYSQL_USER=writing
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
APP_ORIGIN=http://localhost:3000
AUTH_PEPPER=
# Independent 32-byte random key encoded as 64 hex characters. Preserve with backups.
MAIL_ENCRYPTION_KEY=
# false is allowed only for local HTTP development. Production requires HTTPS.
COOKIE_SECURE=false
# starttls (usually 587) or implicit (usually 465); insecure SMTP is not supported.
SMTP_TLS_MODE=starttls
# Local-only API documentation. Keep false for a public deployment by default.
API_ENABLE_DOCS=true

# smtp (default) or resend. Only the selected provider is used.
MAIL_PROVIDER=smtp
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
