    "/local/state": {
      "get": {
        "operationId": "state",
        "summary": "当前进程作业；历史班次以 SQLite 为准",
        "responses": {
          "200": {
            "description": "当前作业或 null",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "job"
                  ],
                  "properties": {
                    "job": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "object",
                          "required": [
                            "id",
                            "kind",
                            "status",
                            "startedAt"
                          ],
                          "properties": {
                            "id": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 9007199254740991
                            },
                            "kind": {
                              "enum": [
                                "shift",
                                "curation",
                                "reconciliation",
                                "effect"
                              ]
                            },
                            "status": {
                              "enum": [
                                "running",
                                "complete",
                                "failed"
                              ]
                            },
                            "startedAt": {
                              "type": "string",
                              "format": "date-time"
                            },
                            "result": {
                              "type": "object"
                            },
                            "error": {
                              "type": "string"
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
